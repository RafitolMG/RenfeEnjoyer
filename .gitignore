# Python
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Node
node_modules/
dist/

# Local SQLite databases (hold Renfe credentials, never commit)
*.db
# Key that encrypts the passwords in that database (backend/credentials.key)
credentials.key

# Activation license a checkout writes when RENFE_ACTIVATION=1 (backend/license.json)
license.json

# Persistent Chrome profile: holds the logged-in Renfe session
browser-profile/
# The app window's own profile (app mode) and WebView2 storage, plus its log
window-profile/
webview/
renfe-enjoyer.log*

# IDE settings (per developer)
.idea/

# PyInstaller output (packaging/renfe-enjoyer.spec)
build/
